# Copy to .env (git-ignored) and adjust. Never commit real values.

# --- database -----------------------------------------------------------------
# Default (omit the variable): SQLite at data/reviewhub.db, no setup needed.
# PostgreSQL (docker compose up -d db):
# REVIEWHUB_DATABASE_URL=postgresql://reviewhub:<POSTGRES_PASSWORD>@localhost:5432/reviewhub
POSTGRES_PASSWORD=change-me

# --- logging ------------------------------------------------------------------
REVIEWHUB_LOG_LEVEL=INFO
REVIEWHUB_LOG_FORMAT=json        # json | text

# --- Review analysis (ADR 0021, 0023) ----------------------------------------------------
# builtin    = offline rule-based analyzer: no key, no network, every review in seconds (default)
# openrouter = LLM via OpenRouter FREE models (needs OPENROUTER_API_KEY); its results take
#              precedence over the rule-based ones. Real guest text is only sent if
#              AI_ALLOW_REAL_GUEST_TEXT=true (a data-protection decision for the operator).
# mock       = deterministic test double (tests only)
AI_PROVIDER=builtin                # builtin | openrouter | mock | none
# AI_ALLOW_REAL_GUEST_TEXT=false
# OPENROUTER_API_KEY=              # backend only; never commit
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free   # must end in :free; verify with `reviewhub ai status --check`
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_CONCURRENCY=2
AI_BATCH_SIZE=10
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_PROMPT_VERSION=v1
AI_TAXONOMY_VERSION=v1

# --- runs / imports -----------------------------------------------------------------
REVIEWHUB_RUN_STALE_AFTER_MINUTES=15
